<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              SoLo-Datei (.solo) direkt mit SoLo öffnen (Messenger, Mail, Dateien-App). Android liefert die Datei als content://-Adresse
              mit Leserecht nur für diese Datei; SoLo braucht dafür keine Speicher-Berechtigung. Für .solo gibt es keinen amtlichen
              MIME-Typ: Apps melden sie meist als application/octet-stream oder application/json. Darum erscheint SoLo auch bei anderen
              Dateien dieser Art in der Auswahl; passt der Inhalt nicht, zeigt SoLo nur einen Hinweis (src/weitergabe.js ausDatei).
              Gelesen wird über den vorhandenen Weg „Von der Beratung bekommen“ mit PIN-Abfrage (src/weitergabe.js nativInit).
              Teilen an SoLo (SEND) wandelt MainActivity.java in Öffnen (VIEW) um.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-solo" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" />
                <data android:pathPattern=".*\\.solo" />
                <data android:pathPattern=".*\\..*\\.solo" />
                <data android:pathPattern=".*\\..*\\..*\\.solo" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-solo" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!--
      INTERNET: Die Android-WebView lädt die App-Dateien über https://localhost (von Capacitor lokal ausgeliefert).
      Ohne diese Berechtigung kann die WebView auf manchen Geräten mit "net::ERR_CACHE_MISS" einen weißen Bildschirm zeigen.
      Die App selbst baut keine Verbindungen ins Internet auf: Die Content-Security-Policy in index.html erlaubt nur
      eigene Dateien (connect-src 'self'), es gibt keine Server, Tracker oder Werbung (siehe test/app-test.js: "Nur lokale Anfragen").
      Kamera: Das Camera-Plugin nutzt die System-Kamera-App; eine CAMERA-Berechtigung ist dafür nicht nötig.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
