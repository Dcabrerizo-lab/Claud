{
  "name": "buerokratie-app",
  "version": "0.0.1",
  "description": "Stammdatenplattform: verschlüsselter Tresor + Formular-Ausfüller (Arbeitsname)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "spike:fixtures": "tsx spike/m0/make-fixtures.ts",
    "spike": "tsx spike/m0/run.ts",
    "spike:render": "node spike/m0/render.mjs",
    "spike:photos": "node spike/m0b/make-photos.mjs",
    "spike:scan": "tsx spike/m0b/run.ts",
    "test:offline": "node spike/m0b/offline-browser.mjs && WORKER_CSP=1 node spike/m0b/offline-browser.mjs",
    "dev": "vite",
    "build": "vite build",
    "test:e2e": "vite build && node test/e2e/app.e2e.mjs && node test/e2e/robust.e2e.mjs && node test/e2e/backup.e2e.mjs && node test/e2e/a11y.e2e.mjs && node test/e2e/fuzz.e2e.mjs",
    "test:mutation": "FC_RUNS=400 stryker run",
    "test:big": "FC_RUNS=50000 vitest run && SESSIONS=60 node test/e2e/fuzz.e2e.mjs",
    "test:coverage": "vitest run --coverage --coverage.include=src/core/** --coverage.include=src/pdf/** --coverage.include=src/scan/**"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.0.1",
    "fast-check": "^4.10.2",
    "jpeg-js": "^0.4.4",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "hash-wasm": "^4.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0"
  }
}
